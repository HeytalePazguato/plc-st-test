(* IEC 61131-3 §6.6.1 / Table 30: 64-bit types wrap modulo 2^64: LINT -2^63..2^63-1, ULINT 0..2^64-1, LWORD 0..2^64-1 (bit string). Values beyond 2^53 must stay exact. *)
FUNCTION_BLOCK TEST_OverflowBigint
VAR l : LINT; ul : ULINT; lw : LWORD; END_VAR
METHOD Test_LintPositiveWrap
  l := 9223372036854775807; l := l + 1;
  ASSERT_EQUAL_LINT(l, -9223372036854775808);
END_METHOD
METHOD Test_LintNegativeWrap
  l := -9223372036854775808; l := l - 1;
  ASSERT_EQUAL_LINT(l, 9223372036854775807);
END_METHOD
METHOD Test_UlintWrap
  ul := 18446744073709551615; ul := ul + 1;
  ASSERT_EQUAL_ULINT(ul, 0);
  ul := 0; ul := ul - 1;
  ASSERT_EQUAL_ULINT(ul, 18446744073709551615);
END_METHOD
METHOD Test_LwordWrap
  lw := 16#FFFF_FFFF_FFFF_FFFF; lw := lw + 1;
  ASSERT_EQUAL_LWORD(lw, 0);
END_METHOD
METHOD Test_PrecisionBeyond2Pow53
  l := 9007199254740993;
  ASSERT_EQUAL_LINT(l, 9007199254740993);
  l := l + 1;
  ASSERT_EQUAL_LINT(l, 9007199254740994);
END_METHOD
METHOD Test_LintMultiplyWrap
  l := 4294967296; l := l * 4294967296;
  ASSERT_EQUAL_LINT(l, 0);
END_METHOD
END_FUNCTION_BLOCK
