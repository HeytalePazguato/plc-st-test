(* IEC 61131-3 §6.6.1 / Table 30 and Table 33: AND/OR/XOR/NOT on bit-string types work bitwise within the type's width (NOT BYTE#16#0F is 16#F0, not a wider value), and BOOL operands use plain logic. *)
FUNCTION_BLOCK TEST_BitOperations
VAR b : BYTE; w : WORD; dw : DWORD; lw : LWORD; END_VAR
METHOD Test_NotStaysInWidth
  b := 16#0F;
  ASSERT_EQUAL_BYTE(NOT b, 16#F0);
  w := 16#00FF;
  ASSERT_EQUAL_WORD(NOT w, 16#FF00);
  dw := 0;
  ASSERT_EQUAL_DWORD(NOT dw, 16#FFFFFFFF);
END_METHOD
METHOD Test_AndOrXor
  b := 16#CC;
  ASSERT_EQUAL_BYTE(b AND 16#0F, 16#0C);
  ASSERT_EQUAL_BYTE(b OR 16#0F, 16#CF);
  ASSERT_EQUAL_BYTE(b XOR 16#FF, 16#33);
END_METHOD
METHOD Test_WordMasks
  w := 16#ABCD;
  ASSERT_EQUAL_WORD(w AND 16#FF00, 16#AB00);
  ASSERT_EQUAL_WORD(w AND 16#00FF, 16#00CD);
  ASSERT_EQUAL_WORD(w XOR w, 0);
END_METHOD
METHOD Test_Lword64BitOps
  lw := 16#8000_0000_0000_0001;
  ASSERT_EQUAL_LWORD(lw AND 16#FFFF_FFFF_0000_0000, 16#8000_0000_0000_0000);
  ASSERT_EQUAL_LWORD(lw OR 16#2, 16#8000_0000_0000_0003);
  ASSERT_EQUAL_LWORD(NOT lw, 16#7FFF_FFFF_FFFF_FFFE);
END_METHOD
METHOD Test_BoolLogicTruthTables
  ASSERT_TRUE(TRUE AND TRUE);
  ASSERT_FALSE(TRUE AND FALSE);
  ASSERT_TRUE(FALSE OR TRUE);
  ASSERT_FALSE(FALSE OR FALSE);
  ASSERT_FALSE(TRUE XOR TRUE);
  ASSERT_TRUE(TRUE XOR FALSE);
  ASSERT_TRUE(NOT FALSE);
  ASSERT_FALSE(NOT TRUE);
END_METHOD
END_FUNCTION_BLOCK
