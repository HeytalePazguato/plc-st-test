{
  "name": "@plc-st/core",
  "version": "0.0.0",
  "description": "Core engine for plc-st-test: IEC 61131-3 Structured Text parser, symbol table, and interpreter.",
  "type": "module",
  "license": "MIT",
  "author": "HeytalePazguato",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HeytalePazguato/plc-st-test.git",
