{
  "name": "plc-st-test-monorepo",
  "private": true,
  "version": "0.0.0",
  "description": "Unit test runner for IEC 61131-3 Structured Text. No PLC runtime, no license, no Windows required. Monorepo workspace root.",
  "type": "module",
  "license": "MIT",
  "author": "HeytalePazguato",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HeytalePazguato/plc-st-test.git"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -b",
    "test": "vitest run",
    "lint": "eslint .",
    "clean": "tsc -b --clean",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm build && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "^10.0.1",
    "@types/node": "~24",
    "@types/sax": "^1.2.7",
    "eslint": "^10.13.0",
    "sax": "^1.6.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5",
    "yaml": "2.9.1"
  },
  "packageManager": "pnpm@11.28.9"
}
